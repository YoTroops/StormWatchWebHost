# No API keys are needed for the initial STORMWATCH build.
# NHC_ENDPOINT=https://www.nhc.noaa.gov/CurrentStorms.json
# Server binds to localhost by default; Docker exposes localhost:8000.
# Do not store third-party API credentials in frontend JavaScript.

# Background refresh schedule (default 300s; bounded 120..1800s)
# STORMWATCH_POLL_SECONDS=300
# STORMWATCH_BACKGROUND_POLL=1
# Satellite: official GOES-19 CONUS, no API key; your browser must allow NOAA CDN images.

# Public ADSB.lol aircraft sightings: no credentials in this local MVP.
# Please review ADSB.lol free API rate limits / ODbL license before public deployment.
